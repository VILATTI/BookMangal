<%= form_with model: booking, class: "space-y-5" do |f| %>

  <% if booking.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-xl px-4 py-3">
      <p class="text-sm font-semibold text-red-700 mb-1">
        Будь ласка, виправте помилки:
      </p>
      <ul class="text-sm text-red-600 space-y-0.5 list-disc list-inside">
        <% booking.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Дата %>
  <div>
    <%= f.label :date, "Дата пікніку", class: "block text-sm font-semibold text-stone-700 mb-1.5" %>
    <%= f.date_field :date,
          min: Date.current,
          class: "w-full border border-stone-300 rounded-xl px-3.5 py-2.5 text-sm text-stone-800
                  focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent
                  transition-colors" %>
  </div>

  <%# Час початку та кінця %>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :start_time, "Початок", class: "block text-sm font-semibold text-stone-700 mb-1.5" %>
      <%= f.select :start_time,
            options_for_select(Booking::HOURS.map { |h| [h, h] }, booking.start_time&.strftime("%H:%M")),
            {},
            class: "w-full border border-stone-300 rounded-xl px-3.5 py-2.5 text-sm text-stone-800
                    focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent
                    transition-colors bg-white" %>
    </div>
    <div>
      <%= f.label :end_time, "Кінець", class: "block text-sm font-semibold text-stone-700 mb-1.5" %>
      <%= f.select :end_time,
            options_for_select(Booking::HOURS.map { |h| [h, h] }, booking.end_time&.strftime("%H:%M")),
            {},
            class: "w-full border border-stone-300 rounded-xl px-3.5 py-2.5 text-sm text-stone-800
                    focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent
                    transition-colors bg-white" %>
    </div>
  </div>

  <p class="text-xs text-stone-400 -mt-3">Час роботи: 08:00 – 22:00</p>

  <%# Нотатки %>
  <div>
    <%= f.label :notes, "Нотатки (необов'язково)", class: "block text-sm font-semibold text-stone-700 mb-1.5" %>
    <%= f.text_area :notes, rows: 3,
          placeholder: "Напр: 6 осіб, з дітьми, потрібне місце з навісом...",
          class: "w-full border border-stone-300 rounded-xl px-3.5 py-2.5 text-sm text-stone-800
                  focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent
                  transition-colors resize-none" %>
  </div>

  <%# Кнопки %>
  <div class="flex gap-3 pt-2">
    <%= f.submit booking.persisted? ? "Зберегти зміни" : "Забронювати 🔥",
          class: "flex-1 bg-orange-500 hover:bg-orange-600 text-white font-semibold py-3 rounded-xl
                  transition-colors shadow-sm cursor-pointer text-sm" %>
    <%= link_to "Скасувати", root_path,
          class: "flex-1 text-center bg-stone-100 hover:bg-stone-200 text-stone-700 font-semibold py-3
                  rounded-xl transition-colors text-sm" %>
  </div>

<% end %>
