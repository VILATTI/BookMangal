<div class="max-w-lg mx-auto">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-stone-800">✏️ Змінити бронювання</h1>
    <p class="text-stone-500 text-sm mt-1">
      Поточний час: <span class="font-medium text-stone-700"><%= @booking.date.strftime("%-d %B") %>, <%= @booking.time_range %></span>
    </p>
  </div>

  <div class="bg-white border border-stone-200 rounded-2xl p-6 shadow-sm">
    <%= render "form", booking: @booking %>
  </div>

  <%# Небезпечна зона %>
  <div class="mt-6 bg-red-50 border border-red-200 rounded-2xl p-5">
    <h3 class="text-sm font-semibold text-red-700 mb-3">Небезпечна зона</h3>
    <div class="flex gap-3">
      <%= button_to "Скасувати бронювання", cancel_booking_path(@booking), method: :patch,
            class: "text-sm font-medium text-red-600 hover:text-red-700 bg-white border border-red-300
                    hover:border-red-400 px-4 py-2 rounded-xl transition-colors cursor-pointer",
            data: { turbo_confirm: "Скасувати це бронювання?" } %>
      <%= button_to "Видалити", booking_path(@booking), method: :delete,
            class: "text-sm font-medium text-red-600 hover:text-red-700 bg-white border border-red-300
                    hover:border-red-400 px-4 py-2 rounded-xl transition-colors cursor-pointer",
            data: { turbo_confirm: "Видалити бронювання назавжди?" } %>
    </div>
  </div>
</div>
