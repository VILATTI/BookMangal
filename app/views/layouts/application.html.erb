<!DOCTYPE html>
<html lang="uk" class="h-full">
  <head>
    <title>BookMangal 🔥</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-full bg-stone-50 font-sans antialiased flex flex-col">

    <%# ===== NAVBAR ===== %>
    <nav class="bg-white border-b border-stone-200 sticky top-0 z-50 shadow-sm">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">

          <%# Logo %>
          <%= link_to root_path, class: "flex items-center gap-2.5 group" do %>
            <div class="w-9 h-9 bg-gradient-to-br from-orange-400 to-red-500 rounded-xl flex items-center justify-center shadow-md group-hover:scale-105 transition-transform">
              <span class="text-lg leading-none">🔥</span>
            </div>
            <span class="font-bold text-xl text-stone-800 tracking-tight">
              Book<span class="text-orange-500">Mangal</span>
            </span>
          <% end %>

          <%# Desktop menu %>
          <div class="hidden sm:flex items-center gap-3">
            <% if user_signed_in? %>
              <%= link_to new_booking_path,
                    class: "inline-flex items-center gap-2 bg-orange-500 hover:bg-orange-600 text-white text-sm font-semibold px-4 py-2 rounded-xl transition-colors shadow-sm" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
                </svg>
                Забронювати
              <% end %>
              <%= link_to edit_profile_path,
                    class: "w-9 h-9 bg-orange-100 hover:bg-orange-200 text-orange-700 font-bold text-sm rounded-full flex items-center justify-center transition-colors",
                    title: current_user.name do %>
                <%= current_user.initials %>
              <% end %>
              <%= button_to "Вийти", destroy_user_session_path, method: :delete,
                    class: "text-stone-400 hover:text-stone-700 text-sm transition-colors cursor-pointer" %>
            <% else %>
              <%= link_to "Увійти", new_user_session_path,
                    class: "text-stone-600 hover:text-stone-800 text-sm font-medium transition-colors" %>
              <%= link_to "Реєстрація", new_user_registration_path,
                    class: "bg-orange-500 hover:bg-orange-600 text-white text-sm font-semibold px-4 py-2 rounded-xl transition-colors shadow-sm" %>
            <% end %>
          </div>

          <%# Mobile burger %>
          <div class="sm:hidden relative" data-controller="mobile-menu">
            <button data-action="click->mobile-menu#toggle"
                    class="p-2 text-stone-500 hover:text-stone-800 rounded-lg transition-colors">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path data-mobile-menu-target="openIcon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                <path data-mobile-menu-target="closeIcon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" class="hidden"/>
              </svg>
            </button>

            <div data-mobile-menu-target="menu"
                 class="hidden absolute right-0 top-12 w-64 bg-white rounded-2xl border border-stone-200 shadow-xl p-4 space-y-1">
              <% if user_signed_in? %>
                <div class="flex items-center gap-3 pb-3 mb-2 border-b border-stone-100">
                  <div class="w-10 h-10 bg-orange-100 text-orange-700 font-bold text-sm rounded-full flex items-center justify-center flex-shrink-0">
                    <%= current_user.initials %>
                  </div>
                  <div class="min-w-0">
                    <p class="text-sm font-semibold text-stone-800 truncate"><%= current_user.name %></p>
                    <p class="text-xs text-stone-400 truncate"><%= current_user.email %></p>
                  </div>
                </div>
                <%= link_to "🔥 Забронювати мангал", new_booking_path,
                      class: "flex items-center gap-2 text-sm font-semibold text-orange-600 hover:bg-orange-50 px-3 py-2.5 rounded-xl transition-colors" %>
                <%= link_to "👤 Мій профіль", edit_profile_path,
                      class: "flex items-center gap-2 text-sm text-stone-700 hover:bg-stone-50 px-3 py-2.5 rounded-xl transition-colors" %>
                <%= button_to "🚪 Вийти", destroy_user_session_path, method: :delete,
                      class: "flex items-center gap-2 text-sm text-stone-400 hover:bg-stone-50 px-3 py-2.5 rounded-xl transition-colors w-full text-left cursor-pointer" %>
              <% else %>
                <%= link_to "Увійти", new_user_session_path,
                      class: "block text-sm font-medium text-stone-700 hover:bg-stone-50 px-3 py-2.5 rounded-xl" %>
                <%= link_to "Реєстрація", new_user_registration_path,
                      class: "block text-sm font-semibold text-orange-600 hover:bg-orange-50 px-3 py-2.5 rounded-xl" %>
              <% end %>
            </div>
          </div>

        </div>
      </div>
    </nav>

    <%# ===== FLASH ===== %>
    <% if notice || alert %>
      <div class="max-w-6xl mx-auto w-full px-4 sm:px-6 lg:px-8 pt-4">
        <% if notice %>
          <div class="flex items-center gap-3 bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-xl text-sm font-medium animate-fade-in">
            <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <%= notice %>
          </div>
        <% end %>
        <% if alert %>
          <div class="flex items-center gap-3 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl text-sm font-medium animate-fade-in">
            <svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <%= alert %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# ===== MAIN ===== %>
    <main class="flex-1 max-w-6xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-6">
      <%= yield %>
    </main>

    <%# ===== FOOTER ===== %>
    <footer class="border-t border-stone-200 py-6 text-center text-sm text-stone-400">
      🔥 BookMangal — бронюй мангал, смажи м'ясо, насолоджуйся!
    </footer>

  </body>
</html>
