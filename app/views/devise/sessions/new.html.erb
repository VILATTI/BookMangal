<div class="max-w-md mx-auto">
  <div class="text-center mb-8">
    <div class="inline-flex w-16 h-16 bg-gradient-to-br from-orange-400 to-red-500 rounded-2xl
                items-center justify-center text-3xl shadow-lg mb-4">
      🔥
    </div>
    <h1 class="text-2xl font-bold text-stone-800">Вхід до BookMangal</h1>
    <p class="text-stone-500 text-sm mt-1">Раді вас бачити знову!</p>
  </div>

  <div class="bg-white border border-stone-200 rounded-2xl p-6 shadow-sm">
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), class: "space-y-5") do |f| %>

      <div>
        <%= f.label :email, "Email", class: "block text-sm font-semibold text-stone-700 mb-1.5" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full border border-stone-300 rounded-xl px-3.5 py-2.5 text-sm
                      focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent transition-colors" %>
      </div>

      <div>
        <%= f.label :password, "Пароль", class: "block text-sm font-semibold text-stone-700 mb-1.5" %>
        <%= f.password_field :password, autocomplete: "current-password",
              class: "w-full border border-stone-300 rounded-xl px-3.5 py-2.5 text-sm
                      focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent transition-colors" %>
      </div>

      <div class="flex items-center justify-between text-sm">
        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.check_box :remember_me, class: "rounded text-orange-500 focus:ring-orange-400" %>
          <span class="text-stone-600">Запам'ятати мене</span>
        </label>
        <%= link_to "Забули пароль?", new_user_password_path,
              class: "text-orange-500 hover:text-orange-700 font-medium" %>
      </div>

      <%= f.submit "Увійти",
            class: "w-full bg-orange-500 hover:bg-orange-600 text-white font-semibold py-3
                    rounded-xl transition-colors shadow-sm cursor-pointer text-sm" %>
    <% end %>
  </div>

  <p class="text-center text-sm text-stone-500 mt-4">
    Ще немає акаунту?
    <%= link_to "Зареєструватись", new_user_registration_path,
          class: "text-orange-500 hover:text-orange-700 font-semibold" %>
  </p>
</div>
